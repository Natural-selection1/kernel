import("//build/templates/rust.gni")

# Compile the positive fixture normally to obtain the same dependency and cfg
# arguments as an ordinary GN Rust target. The runner reuses its command
# metadata.
template("rust_compile_tests") {
  assert(current_toolchain == "//build/toolchain:host")
  _probe = "${target_name}_probe"
  build_rust(_probe) {
    testonly = true
    crate_type = "rlib"
    sources = [ invoker.pass ]
    deps = invoker.deps
  }
  action(target_name) {
    testonly = true
    script = "//build/scripts/check_rust_compile_tests.py"
    _command = "${target_out_dir}/${_probe}.clippy_rsp"
    _out = "${target_gen_dir}/${target_name}"
    deps = [ ":${_probe}" ]
    inputs = invoker.fail + [
               invoker.pass,
               _command,
             ]
    outputs = [ "${_out}/passed" ]
    args = [
             "--command-file",
             rebase_path(_command, root_build_dir),
             "--pass",
             rebase_path(invoker.pass, root_build_dir),
             "--out-dir",
             rebase_path(_out, root_build_dir),
           ] + rebase_path(invoker.fail, root_build_dir)
  }
}
