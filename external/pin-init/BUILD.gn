import("//build/templates/build_template.gni")
import("//build/templates/rust_compile_tests.gni")
import("//build/toolchain/blueos.gni")

build_rust("pin_init_internal") {
  crate_type = "proc-macro"
  rustflags = [ "--extern=proc_macro" ]
  sources = [ "internal/src/lib.rs" ]
  deps = [
    "//external/rust:proc-macro2",
    "//external/rust:quote",
    "//external/rust:syn",
  ]
}

build_rust("pin_init") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  features = [ "alloc" ]
  proc_macro_deps = [ ":pin_init_internal" ]
}

group("check_pin_init") {
  testonly = true
  deps = [
    ":pin_init_compile_tests(//build/toolchain:host)",
    ":run_pin_init_contract_test(//build/toolchain:host)",
  ]
}
group("check_pin_init_by_miri") {
  testonly = true
  deps = [
    ":pin_init_miri_test",
    ":pin_init_tree_borrows_test",
  ]
}
if (current_toolchain == "//build/toolchain:host") {
  build_rust("pin_init_contract_test") {
    testonly = true
    crate_type = "bin"
    sources = [ "tests/contract.rs" ]
    deps = [
      ":pin_init",
      "//kernel/test_support/allocation:allocation_test_support",
    ]
    rustflags = [ "--test" ]
  }
  run_host("run_pin_init_contract_test") {
    testonly = true
    runner = ":pin_init_contract_test"
  }
  rust_compile_tests("pin_init_compile_tests") {
    deps = [ ":pin_init" ]
    pass = "tests/ui/pass.rs"
    fail = [
      "tests/ui/maybe_uninit.rs",
      "tests/ui/non_pin_field.rs",
      "tests/ui/move_pinned.rs",
    ]
  }
}
miri_test("pin_init_miri_test") {
  crate = "tests/contract.rs"
  deps = [
    ":pin_init",
    "//kernel/test_support/allocation:allocation_test_support",
  ]
}
miri_test("pin_init_tree_borrows_test") {
  crate = "tests/contract.rs"
  deps = [
    ":pin_init",
    "//kernel/test_support/allocation:allocation_test_support",
  ]
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}
