import("//build/templates/build_template.gni")
import("//build/templates/rust_compile_tests.gni")
import("//build/toolchain/blueos.gni")

group("check_infra") {
  testonly = true
  deps = [
    ":check_infra_allocation",
    ":check_infra_arc",
    ":check_infra_init",
    ":run_infra_unittest",
  ]
}

# Isolated allocation tests do not run the unrelated intrusive-container tests.
group("check_infra_allocation") {
  testonly = true
  deps = [ ":run_infra_allocation_test(//build/toolchain:host)" ]
}

group("check_infra_allocation_by_miri") {
  testonly = true
  deps = [
    ":infra_allocation_miri_test",
    ":infra_allocation_tree_borrows_test",
  ]
}

group("check_infra_by_miri") {
  testonly = true
  deps = [ ":infra_miri_test" ]
}

group("check_rwlock_by_miri") {
  testonly = true
  deps = [ ":rwlock_miri_test" ]
}

group("check_infra_by_clippy") {
  testonly = true
  deps = [
    ":blueos_infra_clippy",
    ":infra_unittest_clippy",
  ]
}

shared_deps = [
  "//external/pin-init:pin_init",
  "//external/rust:memchr",
  "//external/rust:spin",
]

build_rust("blueos_infra") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = shared_deps
}

run_clippy("blueos_infra_clippy") {
  deps = [ ":blueos_infra" ]
}

miri_test("infra_miri_test") {
  crate = "src/lib.rs"
  deps = shared_deps
}

miri_test("rwlock_miri_test") {
  crate = "src/lib.rs"
  edition = "2024"
  deps = shared_deps
  test_filter = "tinyrwlock::tests::"
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}

build_rust("infra_unittest") {
  testonly = true
  crate_name = "infra_unittest"
  crate_type = "bin"
  sources = [ "src/lib.rs" ]
  edition = "2024"

  deps = shared_deps
  rustflags = [ "--test" ]
}

run_clippy("infra_unittest_clippy") {
  testonly = true
  deps = [ ":infra_unittest" ]
}

run_host("run_infra_unittest") {
  testonly = true
  runner = ":infra_unittest"
}

if (current_toolchain == "//build/toolchain:host") {
  build_rust("infra_allocation_test") {
    testonly = true
    crate_type = "bin"
    sources = [ "tests/allocation.rs" ]
    deps = [
      ":blueos_infra",
      "//kernel/test_support/allocation:allocation_test_support",
    ]
    rustflags = [ "--test" ]
  }

  run_host("run_infra_allocation_test") {
    testonly = true
    runner = ":infra_allocation_test"
  }
}

miri_test("infra_allocation_miri_test") {
  crate = "tests/allocation.rs"
  deps = [
    ":blueos_infra",
    "//kernel/test_support/allocation:allocation_test_support",
  ]
}

miri_test("infra_allocation_tree_borrows_test") {
  crate = "tests/allocation.rs"
  deps = [
    ":blueos_infra",
    "//kernel/test_support/allocation:allocation_test_support",
  ]
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}

# Initialization contracts link the production libraries, with a host allocator.
group("check_infra_init") {
  testonly = true
  deps = [
    ":infra_init_compile_tests(//build/toolchain:host)",
    ":run_infra_init_test(//build/toolchain:host)",
  ]
}
group("check_infra_init_by_miri") {
  testonly = true
  deps = [
    ":infra_init_miri_test",
    ":infra_init_tree_borrows_test",
  ]
}
_init_test_deps = [
  ":blueos_infra",
  "//external/pin-init:pin_init",
  "//kernel/test_support/allocation:allocation_test_support",
]
if (current_toolchain == "//build/toolchain:host") {
  build_rust("infra_init_test") {
    testonly = true
    crate_type = "bin"
    sources = [ "tests/init.rs" ]
    deps = _init_test_deps
    rustflags = [ "--test" ]
  }
  run_host("run_infra_init_test") {
    testonly = true
    runner = ":infra_init_test"
  }
  rust_compile_tests("infra_init_compile_tests") {
    deps = _init_test_deps
    pass = "tests/init_ui/pass.rs"
    fail = [
      "tests/init_ui/move_pinned.rs",
      "tests/init_ui/opaque_wrapper.rs",
      "tests/init_ui/opaque_sync.rs",
      "tests/init_ui/opaque_unpin.rs",
    ]
  }
}
miri_test("infra_init_miri_test") {
  crate = "tests/init.rs"
  deps = _init_test_deps
}
miri_test("infra_init_tree_borrows_test") {
  crate = "tests/init.rs"
  deps = _init_test_deps
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}

# Public Arc contracts link the production library. Private count tests use
# the ordinary library test entry point, filtered to arc::refcount_tests:: only.
group("check_infra_arc") {
  testonly = true
  deps = [
    ":infra_arc_compile_tests(//build/toolchain:host)",
    ":run_infra_arc_private_test(//build/toolchain:host)",
    ":run_infra_arc_test(//build/toolchain:host)",
  ]
}
group("check_infra_arc_by_miri") {
  testonly = true
  deps = [
    ":infra_arc_miri_test",
    ":infra_arc_private_miri_test",
    ":infra_arc_private_tree_borrows_test",
    ":infra_arc_tree_borrows_test",
  ]
}
_arc_test_deps = [
  ":blueos_infra",
  "//kernel/test_support/allocation:allocation_test_support",
]
if (current_toolchain == "//build/toolchain:host") {
  build_rust("infra_arc_test") {
    testonly = true
    crate_type = "bin"
    sources = [ "tests/arc.rs" ]
    deps = _arc_test_deps
    rustflags = [ "--test" ]
  }
  run_host("run_infra_arc_test") {
    testonly = true
    runner = ":infra_arc_test"
  }
  action("run_infra_arc_private_test") {
    testonly = true
    deps = [ ":infra_unittest" ]
    script = "//build/scripts/run_cmd.py"
    args = [
      "-b",
      rebase_path("$root_out_dir/bin/infra_unittest") + " arc::refcount_tests::",
    ]
    outputs = [ "$target_gen_dir/$target_name/dummy" ]
  }
  rust_compile_tests("infra_arc_compile_tests") {
    deps = _arc_test_deps
    pass = "tests/arc_ui/pass.rs"
    fail = [
      "tests/arc_ui/unique_clone.rs",
      "tests/arc_ui/arc_mut.rs",
      "tests/arc_ui/move_pinned.rs",
      "tests/arc_ui/arc_send.rs",
      "tests/arc_ui/arc_sync.rs",
      "tests/arc_ui/arc_sync_non_send.rs",
      "tests/arc_ui/unique_sync.rs",
      "tests/arc_ui/unique_send.rs",
    ]
  }
}
miri_test("infra_arc_miri_test") {
  crate = "tests/arc.rs"
  deps = _arc_test_deps
}
miri_test("infra_arc_tree_borrows_test") {
  crate = "tests/arc.rs"
  deps = _arc_test_deps
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}
miri_test("infra_arc_private_miri_test") {
  crate = "src/lib.rs"
  deps = shared_deps
  test_filter = "arc::refcount_tests::"
}
miri_test("infra_arc_private_tree_borrows_test") {
  crate = "src/lib.rs"
  deps = shared_deps
  test_filter = "arc::refcount_tests::"
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}
