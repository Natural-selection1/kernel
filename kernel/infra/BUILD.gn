import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

group("check_infra") {
  testonly = true
  deps = [ ":run_infra_unittest" ]
}

group("check_infra_by_miri") {
  testonly = true
  deps = [ ":infra_miri_test" ]
}

group("check_rwlock_by_miri") {
  testonly = true
  deps = [ ":rwlock_miri_test" ]
}

group("check_infra_by_clippy") {
  testonly = true
  deps = [
    ":blueos_infra_clippy",
    ":infra_unittest_clippy",
  ]
}

shared_deps = [
  "//external/rust:memchr",
  "//external/rust:spin",
]

build_rust("blueos_infra") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = shared_deps
}

run_clippy("blueos_infra_clippy") {
  deps = [ ":blueos_infra" ]
}

miri_test("infra_miri_test") {
  crate = "src/lib.rs"
  deps = shared_deps
}

miri_test("rwlock_miri_test") {
  crate = "src/lib.rs"
  edition = "2024"
  deps = shared_deps
  test_filter = "tinyrwlock::tests::"
  extra_miri_flags = [ "-Zmiri-tree-borrows" ]
}

build_rust("infra_unittest") {
  testonly = true
  crate_name = "infra_unittest"
  crate_type = "bin"
  sources = [ "src/lib.rs" ]
  edition = "2024"

  deps = shared_deps
  rustflags = [ "--test" ]
}

run_clippy("infra_unittest_clippy") {
  testonly = true
  deps = [ ":infra_unittest" ]
}

run_host("run_infra_unittest") {
  testonly = true
  runner = ":infra_unittest"
}

# Audit all tests independently so the first UB does not hide later failures.
# Both targets deliberately fail when any case fails; reports remain on disk.
group("check_infra_miri_audit") {
  testonly = true
  deps = [
    ":infra_miri_audit_stacked",
    ":infra_miri_audit_tree",
  ]
}

foreach(model,
        [
          "stacked",
          "tree",
        ]) {
  miri_test("infra_miri_audit_${model}") {
    crate = "src/lib.rs"
    deps = shared_deps
    inputs = [
      "//build/scripts/miri/run_miri.py",
      "//build/scripts/miri/isolated_tests.py",
    ]
    rustenv = [ "BLUEOS_MIRI_ISOLATE_TESTS=1" ]
    if (model == "tree") {
      extra_miri_flags = [ "-Zmiri-tree-borrows" ]
    }
  }
}
